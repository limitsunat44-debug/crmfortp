# ============================================================================
# Переменные окружения для scripts/sync-sales.js
# Скопируйте в .env (или экспортируйте в окружении CI/cron) и заполните.
# НЕ коммитьте реальный .env с секретами.
# ============================================================================

# --- 1С OData ---------------------------------------------------------------
# URL базы OData, напр.: https://example.com/base/odata/standard.odata
ONEC_ODATA_URL=
ONEC_BASIC_USER=
ONEC_BASIC_PASSWORD=

# --- DocSales (Supabase REST источника) -------------------------------------
DOCSALES_SUPABASE_URL=
DOCSALES_SERVICE_ROLE_KEY=

# --- Целевой CRM Supabase ---------------------------------------------------
CRM_SUPABASE_URL=
CRM_SERVICE_ROLE_KEY=
